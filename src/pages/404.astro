---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Makeup Academy Manila"
  description="The page you are looking for does not exist. Explore our classes or contact us."
>
  <section class="bg-wine text-white">
    <div class="wrap pt-40 pb-20 md:pt-52 md:pb-28 text-center">
      <p class="eyebrow text-gold mb-6">Page not found</p>
      <h1 class="display-xl text-white">Four. Oh. Four.</h1>
      <p class="mt-6 max-w-md mx-auto text-white/75 text-lg leading-relaxed">
        The page you're looking for doesn't exist, but your class might.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <a href="/classes" class="btn btn-gold">Browse classes</a>
        <a href="/" class="btn btn-outline-light">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
