---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Makeup Academy Manila"
  description="The page you are looking for does not exist. Explore our classes or contact us."
>
  <section class="bg-wine text-white">
    <div class="wrap pt-40 pb-20 md:pt-52 md:pb-28">
      <h1 class="display-lg text-white max-w-3xl text-balance">This Page Is Not Here.</h1>
      <p class="mt-6 max-w-xl text-white/80 text-lg leading-relaxed">
        The address you followed does not exist on this site. The class catalogue, the studio
        details, and admissions are all still open.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="/classes" class="btn btn-gold">Browse classes</a>
        <a href="/" class="btn btn-outline-light">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
