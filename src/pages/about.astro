---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import InquiryCTA from "../components/InquiryCTA.astro";
import { site } from "../data/site";
import { founderCredentials } from "../data/industry";

// Design slots: mission/vision use wording from the original site snapshot.
// Replace with official academy statements when available.
const mission = {
  title: "Our Mission",
  body: "Teach makeup as a craft with discipline, structure, and professional standards. Every program runs face to face in the Quezon City studio: real models, immediate correction, no online modules and no recorded demos.",
};

const vision = {
  title: "Our Vision",
  body: "Graduates leave with more than a certificate: working technique, a portfolio, OJT hours on real productions, and an alumni network that stays useful long after the final class.",
};

const teamSlots = [
  { name: site.founder, role: "Founder & Lead Instructor", photo: "/images/instructor.jpg", ready: true },
  { name: "Instructor profiles", role: "Bridal · SFX · Airbrush · Hair", photo: null, ready: false },
  { name: "Teaching assistants", role: "Studio floor support", photo: null, ready: false },
  { name: "Guest educators", role: "Industry intensives", photo: null, ready: false },
];
---

<BaseLayout
  title="About Faye Young & Makeup Academy Manila | Face-to-Face Artistry Training"
  description="Founded by Faye Young, Makeup Academy Manila has trained makeup and hairstyling artists through face-to-face classes for over two decades. Learn the philosophy behind the studio."
  ogImage="/images/instructor.jpg"
>
  <PageHero
    eyebrow="About us"
    title="A School Built on Craft and Correction"
    intro="Makeup is a physical skill. Brush pressure, blending timing, and skin reading only improve with a trained instructor standing beside you. That is why every program here runs face to face."
    image="/images/instructor.jpg"
  />

  <!-- Mission & Vision -->
  <section class="bg-cream border-b border-line/70 py-20 md:py-28">
    <div class="wrap grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      {
        [mission, vision].map((slot) => (
          <div class="reveal border-t-2 border-gold pt-8">
            <h2 class="font-display text-3xl text-balance">{slot.title}</h2>
            <p class="mt-5 text-muted leading-relaxed text-lg">{slot.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Faye Young -->
  <section class="py-20 md:py-28">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 reveal">
        <img
          src="/images/instructor.jpg"
          alt="An instructor demonstrating makeup technique at the academy"
          class="rounded-card w-full aspect-[4/5] object-cover"
          loading="lazy"
          width="800"
          height="1000"
        />
        <p class="text-xs text-muted mt-3">Instruction at the Quezon City studio.</p>
      </div>
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow text-muted mb-5">{site.founder} · Founder & Lead Instructor</p>
        <h2 class="display-lg text-balance">A Pioneering Figure in Philippine Makeup Artistry.</h2>
        <div class="mt-6 space-y-5 text-muted leading-relaxed">
          <p>
            {site.founder} has worked across bridal couture, fashion editorial, film and television,
            theatre, and international pageant stages for over 27 years.
          </p>
          <p>
            She has been faculty at the Australian College of Hair Design and Beauty Manila since
            2015, training the next generation of makeup artists. Her technical background includes
            prosthetics and airbrush makeup, studied at Singapore's Top to Toe Makeup College, with
            further training under Filipino makeup educator Cecille Rebollos.
          </p>
        </div>

        <p class="eyebrow text-muted mt-12 mb-5">Credentials & recognition</p>
        <ul class="border-t border-line">
          {
            founderCredentials.map((c) => (
              <li class="reveal flex gap-4 items-baseline py-3.5 border-b border-line text-sm">
                <span class="text-gold-ink" aria-hidden="true">—</span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Teaching team slots -->
  <section class="bg-cream border-y border-line/70 py-20">
    <div class="wrap">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow text-muted mb-4">Our teaching team</p>
        <h2 class="font-display text-3xl text-balance">Every Instructor Is a Working Professional.</h2>
        <p class="mt-5 text-muted leading-relaxed">
          Instructors specialize across bridal, SFX, airbrush, hairstyling, and editorial makeup.
          Each brings current client and production experience into the room.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          teamSlots.map((m) => (
            <article class="reveal rounded-card bg-paper border border-line/70 p-6 flex flex-col">
              {m.photo ? (
                <img
                  src={m.photo}
                  alt={m.name}
                  class="rounded-card w-full aspect-[4/3] object-cover mb-5"
                  loading="lazy"
                  width="640"
                  height="480"
                />
              ) : (
                <div
                  class="rounded-card w-full aspect-[4/3] bg-surface border border-line/60 mb-5 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <span class="font-display text-4xl text-line">···</span>
                </div>
              )}
              <h3 class="font-display text-xl leading-snug">{m.name}</h3>
              <p class="mt-1.5 text-sm text-muted">{m.role}</p>
              {!m.ready && (
                <p class="mt-4 pt-4 border-t border-line text-xs text-muted leading-relaxed">
                  Profile slot ready for photo and bio.
                </p>
              )}
            </article>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-muted border-l-2 border-gold pl-5 max-w-2xl">
        Instructor bios and photos are being collected from the teaching team. This section fills in
        as they arrive.
      </p>
    </div>
  </section>

  <!-- Who thrives here -->
  <section class="py-20 md:py-28">
    <div class="wrap">
      <p class="eyebrow text-muted mb-4">Who thrives here</p>
      <h2 class="display-lg mb-12">A Path for Every Artist.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          [
            {
              t: "Beginners",
              d: "Build a reliable everyday routine or your first paid skill set.",
            },
            {
              t: "Bridal Artists",
              d: "Book weddings with confidence, from trial to ceremony.",
            },
            {
              t: "Fashion & Editorial",
              d: "Deliver set-ready work for designers, photographers, and stylists.",
            },
            {
              t: "SFX Creators",
              d: "Train for film, TV, theatre, and character work.",
            },
          ].map((x, i) => (
            <div class="reveal border-t-2 border-gold pt-5">
              <span class="font-display text-gold-ink text-lg">0{i + 1}</span>
              <h3 class="font-display text-2xl mt-2">{x.t}</h3>
              <p class="mt-3 text-sm text-muted leading-relaxed">{x.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <InquiryCTA
    title="Visit Us in Quezon City."
    body="See the studio, meet the team, and get honest advice on which program fits your goals."
  />
</BaseLayout>
