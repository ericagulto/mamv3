---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CourseCard from "../../components/CourseCard.astro";
import InquiryCTA from "../../components/InquiryCTA.astro";
import { courses, levelPaths, standardInclusions } from "../../data/courses";
import type { Course } from "../../data/courses";

const bySlug = new Map(courses.map((c) => [c.slug, c]));
const byLevel = (slugs: readonly string[]) =>
  slugs
    .map((s) => bySlug.get(s))
    .filter((c): c is Course => c !== undefined);
---

<BaseLayout
  title="All Makeup & Hairstyling Classes in Quezon City | Makeup Academy Manila"
  description="11 face-to-face makeup and hairstyling programs at the Quezon City studio, from a 1-day personal class to a 10-day prosthetics course, with materials, certificate, portfolio images and OJT included."
  ogImage="/images/classroom.jpg"
>
  <PageHero
    title="Classes & Courses"
    intro="From a one-day personal class to a ten-day prosthetics intensive: hands-on, materials included, with a certificate, portfolio images, and OJT opportunities."
    image="/images/classroom.jpg"
  >
    <div slot="cta" class="mt-9 flex flex-wrap gap-4">
      <a href="/contact" class="btn btn-gold">Talk to an advisor</a>
      <a href="#programs" class="btn btn-outline-light">See the programs</a>
    </div>
  </PageHero>

  <section id="programs" class="py-20 md:py-24 scroll-mt-24">
    <div class="wrap space-y-20 md:space-y-24">
      {
        levelPaths.map((group) => {
          const groupCourses = byLevel(group.slugs);
          return (
            <div>
              <div class="sticky top-20 md:top-24 z-20 bg-paper flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 border-b border-line pb-6">
                <h2 class="font-display text-3xl md:text-4xl">{group.name}</h2>
                <p class="sm:text-right sm:max-w-md text-sm text-muted leading-relaxed">
                  {group.blurb}
                </p>
              </div>
              <div class:list={["mt-9 grid grid-cols-1 md:grid-cols-2 gap-6", groupCourses.length === 4 ? "lg:grid-cols-2" : "lg:grid-cols-3"]}>
                {groupCourses.map((c, i) => (
                  <CourseCard course={c} eager={group.key === "beginner" && i < 2} />
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="bg-cream border-y border-line/70 py-20 md:py-24">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 reveal">
        <h2 class="font-display text-3xl text-balance">How Enrollment Works</h2>
        <p class="mt-5 text-muted leading-relaxed">
          Class sizes stay small so every student gets direct instructor time.
          Seats fill early; inquire as soon as you know your dates.
        </p>
        <p class="mt-4 text-muted leading-relaxed">
          All classes run face to face at the Quezon City studio, Monday to
          Saturday. Intake dates open as they are set, or contact us to hold
          your seat.
        </p>
        <a href="/contact" class="btn btn-primary mt-8">Reserve Your Spot</a>
      </div>

      <div class="lg:col-span-7 reveal">
        <h2 class="font-display text-3xl text-balance">Every Tuition Includes</h2>
        <ul class="mt-7 border-t border-line">
          {
            standardInclusions.map((item) => (
              <li class="flex items-baseline gap-5 py-4 border-b border-line">
                <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 translate-y-[-2px]" aria-hidden="true"></span>
                <span class="text-lg">{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm text-muted leading-relaxed">
          Foundations assume no experience. Intermediate classes add specialty
          technique. Professional tracks carry OJT on real bookings. Tell us
          where you are and we will place you honestly.
        </p>
      </div>
    </div>
  </section>

  <InquiryCTA />
</BaseLayout>
