---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InquiryCTA from "../../components/InquiryCTA.astro";
import { courses, getCourse, formatTuition, standardInclusions } from "../../data/courses";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const related = course.related.map((slug) => getCourse(slug)!).filter(Boolean);

const details = [
  ["Tuition", `${formatTuition(course.tuition)} per student`],
  ["Duration", `${course.days} ${course.days === 1 ? "day" : "days"}`],
  ["Level", course.level],
  ["Discipline", course.discipline],
  ["Format", "Hands-on, materials included"],
  ["Location", "Quezon City, Metro Manila"],
  ["Succeeding courses", "10% discount"],
];
---

<BaseLayout title={`${course.name} | ${formatTuition(course.tuition)} · ${course.days} ${course.days === 1 ? "Day" : "Days"} | Makeup Academy Manila`} description={`${course.intro} ${formatTuition(course.tuition)} per student. Face-to-face in Quezon City. Materials, certificate, portfolio images, and OJT included.`} ogImage={course.image}>
  <!-- Hero: course image as full-bleed background under a wine overlay -->
  <section class="bg-wine text-white relative overflow-hidden">
    <img
      src={course.image}
      alt={course.imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      width="800"
      height="600"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-wine via-wine/90 to-wine/65" aria-hidden="true"></div>
    <div class="wrap relative pt-36 pb-16 md:pt-44 md:pb-24">
      <nav aria-label="Breadcrumb" class="text-xs text-white/50 mb-6">
        <a href="/classes" class="hover:text-gold transition-colors">Classes</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-white/75">{course.shortName}</span>
      </nav>
      <div class="max-w-3xl">
        <p class="eyebrow text-gold mb-5">{course.level} · {course.discipline}</p>
        <h1 class="display-lg text-white text-balance">{course.name}</h1>
        <p class="mt-6 text-white/80 text-lg leading-relaxed max-w-2xl">{course.intro}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/contact" class="btn btn-gold">Send an inquiry</a>
          <a href="#details" class="btn btn-outline-light">Course details</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Audience + curriculum -->
  <section class="py-20 md:py-28">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow text-muted mb-5">Who this course is for</p>
          <p class="text-muted leading-relaxed">{course.audience}</p>
          <div class="mt-10 rounded-card bg-cream border border-line/60 p-7">
            <p class="font-display text-4xl text-wine">{formatTuition(course.tuition)}</p>
            <p class="text-sm text-muted mt-1">per student · all materials included</p>
            <a href="/contact" class="btn btn-primary w-full mt-6">Send an inquiry</a>
            <p class="text-xs text-muted mt-4 leading-relaxed">
              Tuition includes all training materials, certificate, portfolio images, and OJT opportunities.
            </p>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-8">
        <p class="eyebrow text-muted mb-6">What you will cover</p>
        <ol class="border-t border-line">
          {
            course.modules.map((m, i) => (
              <li class="reveal grid grid-cols-[auto_1fr] md:grid-cols-[auto_220px_1fr] gap-x-6 md:gap-x-10 py-6 border-b border-line">
                <span class="font-display text-gold-ink text-lg w-8">{String(i + 1).padStart(2, "0")}</span>
                <h2 class="font-display text-xl md:text-2xl leading-snug text-balance">{m.title}</h2>
                <p class="col-span-2 md:col-span-1 mt-2 md:mt-0 text-muted text-sm md:text-[1.05rem] leading-relaxed">{m.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-14">
          <p class="eyebrow text-muted mb-6">What you will receive</p>
          <ul class="reveal grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-3">
            {
              standardInclusions.map((item) => (
                <li class="flex gap-3 items-baseline text-sm">
                  <span class="text-gold-ink" aria-hidden="true">—</span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal mt-14 rounded-card bg-cream border border-line/60 p-8 md:p-10">
          <p class="eyebrow text-muted mb-5">How training works</p>
          <p class="text-lg leading-relaxed">{course.howItWorks}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Details ledger -->
  <section id="details" class="bg-wine-ink text-white py-20 md:py-24 scroll-mt-20">
    <div class="wrap">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <h2 class="lg:col-span-3 font-display text-3xl">Course Details</h2>
        <dl class="lg:col-span-9">
          {
            details.map(([label, value]) => (
              <div class="reveal grid grid-cols-1 sm:grid-cols-[220px_1fr] gap-1 sm:gap-8 py-4 border-t border-white/15">
                <dt class="eyebrow text-white/70 pt-1">{label}</dt>
                <dd class="text-lg text-white/90">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="bg-cream border-t border-line/70 py-20 md:py-24">
    <div class="wrap">
      <p class="eyebrow text-muted mb-8">Related courses</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          related.map((r) => (
            <a href={`/classes/${r.slug}`} class="group reveal border-t-2 border-gold pt-5">
              <p class="text-xs text-muted uppercase tracking-[0.18em]">{r.level}</p>
              <h3 class="font-display text-2xl mt-2 group-hover:text-wine-soft transition-colors">{r.shortName}</h3>
              <p class="mt-2 text-sm text-muted">{r.days} {r.days === 1 ? "day" : "days"} · {formatTuition(r.tuition)}</p>
              <span class="inline-block mt-4 text-sm text-wine font-medium group-hover:text-gold-ink transition-colors">
                View details <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <InquiryCTA title={`Ready to Start ${course.shortName}?`} />
</BaseLayout>
