---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import InquiryCTA from "../components/InquiryCTA.astro";
import { highlights } from "../data/industry";
---

<BaseLayout
  title="Industry Highlights & OJT Placements | Makeup Academy Manila"
  description="Newport Performing Arts Theater, Philippine Bridal Fairs, 7th Global Trends, Remarkable Woman, IROG. See where MAM students step into real production environments."
  ogImage="/images/backstage.jpg"
>
  <PageHero
    title="Where the Academy Meets the Industry"
    intro="Partnerships with production companies, event organizers, and bridal brands open real pathways for graduates, from backstage work to OJT placements."
    image="/images/backstage.jpg"
  />

  <section class="bg-cream border-b border-line/70 py-20 md:py-28">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 lg:sticky lg:top-24 self-start">
        <h2 class="display-lg text-balance">The Work Speaks for the School.</h2>
        <p class="mt-6 text-muted leading-relaxed">
          Productions worked, awards received, competitions judged. Instructors
          work in the industry today and bring current technique, products, and
          standards into every class.
        </p>
        <img
          src="/images/backstage-3.jpg"
          alt="MAM interns working backstage at a fashion event"
          class="reveal rounded-card mt-10 w-full aspect-[4/3] object-cover"
          loading="lazy"
          width="800"
          height="600"
        />
      </div>

      <div class="lg:col-span-7">
        <ol class="ledger border-t border-line">
          {
            highlights.map((h, i) => (
              <li class="reveal grid grid-cols-[auto_1fr] gap-x-6 md:gap-x-10 py-8 border-b border-line">
                <span class="numeral text-gold-ink text-lg w-8">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="font-display text-2xl leading-snug text-balance">{h.org}</h3>
                  <p class="mt-1 text-sm text-wine-ink font-medium">{h.title}</p>
                  <p class="mt-3 text-muted leading-relaxed">{h.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-cream border-b border-line/70 py-20 md:py-24">
    <div class="wrap">
      <h2 class="reveal font-display text-3xl md:text-[2.35rem] leading-[1.35] max-w-3xl text-balance">
        We Work the Rooms We Train For.
      </h2>
      <p class="reveal mt-5 text-muted leading-relaxed max-w-2xl">
        The academy has been the official makeup team at Newport Performing Arts Theater, on the
        floor at the Philippine Bridal Fairs, and on the judging panel at IROG.
      </p>
      <a href="/classes" class="reveal btn btn-primary mt-9">Train where the work happens</a>
    </div>
  </section>

  <InquiryCTA />
</BaseLayout>
