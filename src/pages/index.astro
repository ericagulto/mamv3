---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import InquiryCTA from "../components/InquiryCTA.astro";
import { courses, getCourse, formatTuition } from "../data/courses";
import { testimonials } from "../data/testimonials";

// Editorial ledger of three signature programs — numbered rows, not cards
const featuredSlugs = [
  "basic-fundamentals-of-makeup-technical-applications",
  "bridal-masterclass",
  "special-effects-sfx-makeup-masterclass",
];

const featuredQuote = testimonials.find((t) => t.name === "Cheyenne Adamson")!;
const supportingQuotes = [
  testimonials.find((t) => t.name === "Maxene Lati")!,
  testimonials.find((t) => t.name === "CLSHES Shes")!,
];
---

<BaseLayout title="Professional Makeup & Hairstyling Training in Quezon City | Makeup Academy Manila">
  <!-- 01 / HERO — full-bleed studio image, headline anchored low -->
  <section class="relative bg-wine-deep overflow-hidden">
    <!-- The wide studio shot is 16:9 with its two faces at the right third; a
         centre-cropped 390px viewport lands on the mirror and misses them entirely,
         so phones get the portrait frame from the same shoot instead. -->
    <picture>
      <source media="(max-width: 767px)" srcset="/images/hero-portrait.jpg" />
      <img
        src="/images/hero.jpg"
        alt="An instructor applying makeup to a model face to face"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-wine-deep via-wine-deep/45 to-wine-deep/15" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-wine-deep/85 via-wine-deep/35 to-transparent" aria-hidden="true"></div>
    <!-- On a 390px viewport the horizontal scrim resolves to almost nothing at the
         right edge, where the paragraph wraps; a flat tint keeps it above 4.5:1. -->
    <div class="absolute inset-0 bg-wine-deep/30 md:hidden" aria-hidden="true"></div>
    <div class="wrap relative pt-44 pb-24 md:pt-60 md:pb-32">
      <h1 class="display-xl text-white max-w-4xl">
        Professional Makeup & Hairstyling Training, Done Face to Face.
      </h1>
      <p class="mt-6 max-w-xl text-white/80 text-lg leading-relaxed">
        Hands-on makeup and hairstyling classes taught by working industry
        artists. Guided practice on live models builds the technique you will
        actually use on the job.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="/classes" class="btn btn-gold">Explore classes</a>
        <a href="/contact" class="btn btn-outline-light">Contact us</a>
      </div>
    </div>
  </section>

  <!-- 02 / MANIFESTO — pure typography, no boxes; the advantages live in the prose -->
  <section class="py-24 md:py-36">
    <div class="wrap">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <h2 class="lg:col-span-7 reveal self-end display-lg text-balance">
          Makeup Is a Physical Craft. Brush Pressure, Blending Timing, and
          Skin Reading Do Not Survive a Screen.
        </h2>
        <div class="lg:col-span-5 reveal">
          <p class="text-muted leading-relaxed">
            In the studio, instructors stand beside you: adjusting your angle, correcting your
            blend, and fixing the habit while it forms.
          </p>
          <ul class="mt-8 space-y-0">
            {
              [
                "Branded cosmetics and professional tools in every class",
                "Real models, not mannequins",
                "Small class sizes for individual attention",
                "Practice-based learning, not passive demos",
              ].map((item) => (
                <li class="flex gap-4 items-start border-t border-line py-3.5 text-sm">
                  <span class="mt-[0.72rem] w-4 h-px bg-gold-ink shrink-0" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <a href="/about" class="inline-block mt-8 text-wine font-medium hover:text-gold-ink transition-colors">
            How the academy works <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / SIGNATURE PROGRAMS — numbered editorial ledger, not cards -->
  <section class="bg-cream border-y border-line/70 pb-24 md:pb-36 pt-24 md:pt-36">
    <div class="wrap">
      <div class="flex items-end justify-between gap-6 mb-8">
        <div>
          <h2 class="display-lg">Three Ways Artists Start with Us.</h2>
        </div>
        <a href="/classes" class="hidden sm:inline-block text-sm text-wine font-medium hover:text-gold-ink transition-colors whitespace-nowrap">
          All {courses.length} classes <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ledger border-t border-line">
        {
          featuredSlugs.map((slug, i) => {
            const c = getCourse(slug)!;
            return (
              <a
                href={`/classes/${slug}`}
                class="group reveal grid grid-cols-[auto_1fr] md:grid-cols-[auto_1fr_170px_auto] items-baseline gap-x-6 md:gap-x-10 py-8 border-b border-line hover:bg-paper transition-colors px-1 md:px-3"
              >
                <span class="numeral text-gold-ink text-lg w-8">{String(i + 1).padStart(2, "0")}</span>
                <span>
                  <span class="font-display text-2xl md:text-3xl group-hover:text-wine-soft transition-colors text-balance">
                    {c.shortName}
                  </span>
                  <span class="block mt-2 text-muted text-sm md:text-[1.05rem] max-w-2xl leading-relaxed">
                    {c.intro}
                  </span>
                </span>
                <span class="hidden md:block text-sm text-muted">
                  {c.level}
                  <span class="block mt-1 text-xs">{c.days} {c.days === 1 ? "day" : "days"} · hands-on</span>
                </span>
                <span class="text-right font-display text-2xl whitespace-nowrap">{formatTuition(c.tuition)}</span>
              </a>
            );
          })
        }
      </div>
      <a href="/classes" class="sm:hidden inline-block mt-8 text-sm text-wine font-medium">
        All {courses.length} classes <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- 04 / PROOF OF INDUSTRY — dark band: where the academy's work actually happens -->
  <section class="bg-wine-deep text-white py-24 md:py-32">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="reveal lg:col-span-4">
        <h2 class="font-display text-white text-3xl md:text-4xl leading-snug text-balance">
          Graduates Step onto Stages, Film Sets, and Bridal Fair Floors.
        </h2>
        <p class="mt-5 text-white/70 leading-relaxed">
          The academy's work happens outside the studio too: these are bookings and
          recognitions on the record.
        </p>
        <a href="/industry" class="inline-block mt-8 text-white font-medium hover:text-gold transition-colors">
          See the full track record <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="ledger ledger--top lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-0">
        {
          [
            ["Newport Performing Arts Theater", "Official makeup team for Bongga Ka and ’Day!: The Annie Batungbakal Musical"],
            ["7th Global Trends", "Notable Academy for Make Up Artistry"],
            ["Philippine Bridal Fairs", "Leading participation, showcasing the Makeup Academy Manila Bride aesthetic"],
            ["IROG Year 7", "Official judge, Bridal Hair & Makeup Competition"],
          ].map(([org, title]) => (
            <li class="reveal border-t border-white/15 py-6">
              <p class="font-display text-xl md:text-2xl text-gold leading-snug">{org}</p>
              <p class="mt-2 text-white/75 leading-relaxed">{title}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 05 / THE WORK — real photography from the studio and from bookings -->
  <section class="py-24 md:py-32">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="reveal lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
        <h2 class="display-lg text-balance">Face to Face, on Real Faces.</h2>
        <p class="mt-5 text-muted leading-relaxed">
          Practice happens on live models, at studio vanities with real client lighting, and
          eventually on the academy's own bookings.
        </p>
      </div>
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
        <figure class="reveal sm:col-span-2">
          <img
            src="/images/bridal.jpg"
            alt="A bride in a lace gown with her bridal makeup and hair finished, at a venue with flower walls behind her."
            class="rounded-card w-full aspect-[4/5] sm:aspect-[16/10] object-cover"
            loading="lazy"
            width="896"
            height="1200"
          />
          <figcaption class="mt-3 text-xs text-muted">Bridal hair and makeup, finished look.</figcaption>
        </figure>
        <figure class="reveal">
          <img
            src="/images/backstage-2.jpg"
            alt="Makeup Academy Manila artists working a full vanity line backstage at Manila Fashion Week while a show audience sits beyond the curtain."
            class="rounded-card w-full aspect-[4/5] sm:aspect-[4/3] object-cover"
            loading="lazy"
            width="1024"
            height="1024"
          />
          <figcaption class="mt-3 text-xs text-muted">Backstage at Manila Fashion Week.</figcaption>
        </figure>
        <figure class="reveal">
          <img
            src="/images/airbrush.jpg"
            alt="The studio airbrush compressor, foundation shades and tools laid out at a station."
            class="rounded-card w-full aspect-[4/5] sm:aspect-[4/3] object-cover"
            loading="lazy"
            width="1024"
            height="768"
          />
          <figcaption class="mt-3 text-xs text-muted">Airbrush kit at a studio station.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 06 / TESTIMONIALS — one large outcome quote, two supporting, asymmetric -->
  <section class="bg-cream border-y border-line/70 py-24 md:py-32">
    <div class="wrap">
      <figure class="reveal max-w-4xl">
        <blockquote class="quote-display text-2xl md:text-[2rem] leading-[1.4] text-wine-ink">
          “{featuredQuote.quote}”
        </blockquote>
        <figcaption class="mt-5 text-sm text-muted">
          <span class="text-wine-ink font-medium">{featuredQuote.name}</span>
          <span class="mx-2 text-muted" aria-hidden="true">·</span>
          {featuredQuote.source}
        </figcaption>
      </figure>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14 max-w-5xl mt-14">
        {supportingQuotes.map((t) => <TestimonialCard t={t} />)}
      </div>
      <a href="/student-stories" class="inline-block mt-12 text-wine font-medium hover:text-gold-ink transition-colors">
        Read more student stories <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- 07 / CTA -->
  <InquiryCTA />
</BaseLayout>
