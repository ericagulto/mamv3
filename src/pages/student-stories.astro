---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import InquiryCTA from "../components/InquiryCTA.astro";
import { testimonials } from "../data/testimonials";

const [featured, ...reviews] = testimonials;
---

<BaseLayout
  title="Student Stories & Results | Makeup Academy Manila"
  description="What MAM students say about the training, the OJT, and the work they are doing now."
  ogImage="/images/backstage-2.jpg"
>
  <PageHero
    title="Skills Built Through Practice"
    intro="Results here are measured by what students can do, not by what the school claims. The words below are real and shared with permission."
    image="/images/class-hands-on.jpg"
  >
    <div slot="cta" class="mt-9 flex flex-wrap gap-4">
      <a href="/classes" class="btn btn-gold">Explore classes</a>
      <a href="/contact" class="btn btn-outline-light">Discuss your goals</a>
    </div>
  </PageHero>

  <!-- What results means here -->
  <section class="py-20 md:py-28">
    <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-5 reveal">
        <img
          src="/images/backstage-2.jpg"
          alt="Makeup Academy Manila artists working a full vanity line backstage at Manila Fashion Week while a show audience sits beyond the curtain."
          class="rounded-card w-full aspect-square object-cover"
          loading="lazy"
          width="1024"
          height="1024"
        />
        <p class="text-xs text-muted mt-3">Backstage at Manila Fashion Week.</p>
      </div>
      <div class="lg:col-span-7">
        <h2 class="display-lg text-balance">What Results Honestly Means Here.</h2>
        <div class="mt-6 space-y-5 text-muted leading-relaxed max-w-xl">
          <p>
            We measure results the way a school should: by what our students can do, not by what we
            claim. The progress is real. The names are shared with permission.
          </p>
          <p>
            We do not promise jobs, income, or fame. What we deliver is structured training, honest
            correction, and the kind of practice that builds lasting skill.
          </p>
        </div>
        <p class="mt-8 font-display text-xl text-wine-ink">
          Some students arrive for a personal class. Some leave holding a film credit.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured review -->
  <section class="bg-wine-deep text-white py-20 md:py-28">
    <figure class="wrap grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-end reveal">
      <blockquote class="quote-display lg:col-span-8 text-[1.75rem] leading-[1.34] md:text-[2.5rem] md:leading-[1.3] text-white text-balance">
        “{featured.quote}”
      </blockquote>
      <figcaption class="lg:col-span-4 lg:pb-3">
        <span class="block w-12 hairline-dark mb-5" aria-hidden="true"></span>
        <span class="block font-display text-xl text-gold">{featured.name}</span>
        <span class="block mt-1 text-sm text-white/60">{featured.source}</span>
      </figcaption>
    </figure>
  </section>

  <!-- Review wall -->
  <section class="py-20 md:py-28">
    <div class="wrap">
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-12">
        <h2 class="font-display text-3xl md:text-4xl">Everything Else Students Said.</h2>
        <p class="text-sm text-muted">Unedited, from the reviews on the original site.</p>
      </div>
      <div class="columns-1 md:columns-2 lg:columns-3 gap-10">
        {reviews.map((t) => <TestimonialCard t={t} />)}
      </div>
    </div>
  </section>

  <InquiryCTA />
</BaseLayout>
