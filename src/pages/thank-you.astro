---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Thank You | Makeup Academy Manila"
  description="We have received your inquiry. The Makeup Academy Manila team will reply within one business day."
>
  <section class="bg-wine text-white">
    <div class="wrap pt-40 pb-20 md:pt-52 md:pb-28 text-center">
      <p class="text-gold tracking-[0.35em] text-2xl" aria-hidden="true">★★★★★</p>
      <h1 class="display-lg text-white mt-6 text-balance">Thank You. We Have Your Inquiry.</h1>
      <p class="mt-6 max-w-xl mx-auto text-white/80 text-lg leading-relaxed">
        Our admissions team will contact you with schedules, requirements, and
        the next steps for enrollment.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-24 text-center">
    <div class="wrap max-w-xl">
      <p class="text-muted leading-relaxed">
        Need a faster answer? Call us directly at
        <a href={`tel:${site.phoneHref}`} class="text-wine font-medium hover:text-gold-ink transition-colors">{site.phone}</a>
        or email
        <a href={`mailto:${site.email}`} class="text-wine font-medium hover:text-gold-ink transition-colors break-all">{site.email}</a>.
      </p>
      <a href="/classes" class="btn btn-primary mt-10">Keep exploring courses <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
