---
import { site } from "../data/site";

interface Props {
  title?: string;
  body?: string;
}

const {
  title = "Ready to Start Your Training?",
  body = "Tell us which course interests you. We will send the next available dates and everything you need to get started.",
} = Astro.props;

const assurances = [
  ["Studio days", "Monday to Saturday"],
  ["Class size", "Small groups, direct instructor time"],
  ["OJT", "Film, TV, stage and theatre bookings"],
];
---

<section class="bg-wine text-white">
  <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-12 py-20 md:py-28 lg:items-end">
    <div class="lg:col-span-7 reveal">
      <p class="eyebrow text-gold mb-6">Admissions</p>
      <h2 class="display-lg text-white max-w-2xl text-balance">{title}</h2>
      <p class="mt-6 max-w-xl text-white/75 leading-relaxed">{body}</p>
      <div class="mt-9 flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn btn-gold">Send an inquiry</a>
        <a href={`tel:${site.phoneHref}`} class="btn btn-outline-light">Call {site.phone}</a>
      </div>
    </div>
    <dl class="ledger ledger--top lg:col-span-5 reveal border-b border-white/15">
      {
        assurances.map(([label, value]) => (
          <div class="grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-1 sm:gap-6 py-4 border-t border-white/15">
            <dt class="eyebrow text-white/55 pt-1">{label}</dt>
            <dd class="text-white/90">{value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
