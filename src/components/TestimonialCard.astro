---
import type { Testimonial } from "../data/testimonials";

interface Props {
  t: Testimonial;
}

const { t } = Astro.props;
---

<figure class="reveal rounded-card bg-paper border border-line/70 p-6 md:p-8">
  <div class="text-gold-ink tracking-[0.3em] text-sm" aria-label="Five star review">★★★★★</div>
  <blockquote class="mt-4 text-base md:text-lg leading-relaxed text-wine-ink">
    “{t.quote}”
  </blockquote>
  <figcaption class="mt-5 pt-4 border-t border-line text-sm text-muted">
    <span class="text-wine-ink font-medium">{t.name}</span>
    <span class="mx-2 text-muted" aria-hidden="true">·</span>
    {t.source}
  </figcaption>
</figure>
