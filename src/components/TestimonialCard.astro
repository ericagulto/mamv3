---
import type { Testimonial } from "../data/testimonials";

interface Props {
  t: Testimonial;
}

const { t } = Astro.props;
---

<figure class="reveal mb-10 pb-8 border-b border-line break-inside-avoid">
  <!-- Review copy is reading matter, not display type: the display face is
       reserved for the single highlighted quote on each surface. -->
  <blockquote class="text-[1.05rem] md:text-[1.1rem] leading-[1.62] text-body">
    “{t.quote}”
  </blockquote>
  <figcaption class="mt-4 text-sm text-muted">
    <span class="text-wine-ink font-medium">{t.name}</span>
    <span class="mx-2" aria-hidden="true">·</span>
    {t.source}
  </figcaption>
</figure>
