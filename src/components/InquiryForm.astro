---
import { courses } from "../data/courses";
---

<form id="inquiry-form" class="space-y-5" novalidate>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="first-name" class="block text-sm font-medium text-wine-ink mb-1.5">First name</label>
      <input type="text" id="first-name" name="firstName" required autocomplete="given-name" class="input" />
    </div>
    <div>
      <label for="last-name" class="block text-sm font-medium text-wine-ink mb-1.5">Last name</label>
      <input type="text" id="last-name" name="lastName" required autocomplete="family-name" class="input" />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="email" class="block text-sm font-medium text-wine-ink mb-1.5">Email</label>
      <input type="email" id="email" name="email" required autocomplete="email" class="input" />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-wine-ink mb-1.5">Contact phone</label>
      <input type="tel" id="phone" name="phone" required autocomplete="tel" class="input" />
    </div>
  </div>

  <div>
    <label for="program" class="block text-sm font-medium text-wine-ink mb-1.5">Program of interest</label>
    <select id="program" name="program" required class="input">
      <option value="">Select a course…</option>
      <optgroup label="Makeup">
        {
          courses.filter((c) => c.discipline === "Makeup").map((c) => (
            <option value={c.name}>{c.name}</option>
          ))
        }
      </optgroup>
      <optgroup label="Hair">
        {
          courses.filter((c) => c.discipline === "Hair").map((c) => (
            <option value={c.name}>{c.name}</option>
          ))
        }
      </optgroup>
      <optgroup label="Specialty">
        {
          courses.filter((c) => !["Makeup", "Hair"].includes(c.discipline)).map((c) => (
            <option value={c.name}>{c.name}</option>
          ))
        }
      </optgroup>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-wine-ink mb-1.5">Message <span class="text-muted font-normal">(optional)</span></label>
    <textarea id="message" name="message" rows="4" class="input" placeholder="Your goals, experience level, or questions…"></textarea>
  </div>

  <button type="submit" class="btn btn-primary w-full sm:w-auto">Submit inquiry</button>

  <p id="form-success" role="status" class="hidden rounded-field bg-wine text-white text-sm leading-relaxed px-5 py-4">
    Thank you! Your inquiry has been submitted. We will reply within one business day.
    <a href="/thank-you" class="text-gold underline">Here is what happens next</a>.
  </p>
</form>

<style>
  .input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line-strong);
    background: var(--color-cream);
    font: inherit;
    color: var(--color-body);
    border-radius: var(--radius-field);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .input:hover {
    border-color: var(--color-wine);
  }
  .input:focus {
    outline: none;
    background: var(--color-paper);
    border-color: var(--color-wine);
    box-shadow: 0 0 0 3px rgb(198 161 91 / 0.25);
  }
  .input:user-invalid {
    border-color: #a3263a;
  }
</style>

<script>
  const form = document.getElementById("inquiry-form") as HTMLFormElement | null;
  const success = document.getElementById("form-success");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    // Front-end demo — wire to a real endpoint (email service / backend) at launch.
    success?.classList.remove("hidden");
    success?.scrollIntoView({ block: "center" });
    form.reset();
  });
</script>
