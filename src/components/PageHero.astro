---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  image?: string;
}

const { eyebrow, title, intro, image } = Astro.props;
---

<section class="bg-wine text-white relative overflow-hidden">
  {
    image && (
      <img
        src={image}
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-25"
        loading="eager"
        aria-hidden="true"
      />
    )
  }
  <div class="absolute inset-0 bg-gradient-to-r from-wine via-wine/80 to-wine/40" aria-hidden="true"></div>
  <div class="wrap relative pt-40 pb-20 md:pt-52 md:pb-28">
    <p class="eyebrow text-gold mb-5">{eyebrow}</p>
    <h1 class="display-lg text-white max-w-3xl text-balance">{title}</h1>
    {
      intro && (
        <p class="mt-6 max-w-2xl text-white/75 text-lg leading-relaxed">
          {intro}
        </p>
      )
    }
  </div>
</section>
