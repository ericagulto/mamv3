---
import type { Course } from "../data/courses";
import { formatTuition } from "../data/courses";

interface Props {
  course: Course;
  eager?: boolean;
}

const { course, eager = false } = Astro.props;
---

<a
  href={`/classes/${course.slug}`}
  class="group reveal block rounded-card overflow-hidden bg-cream border border-line/60 transition-[border-color,box-shadow] duration-300 hover:border-gold-ink hover:shadow-[0_18px_44px_-26px_rgb(34_0_22/0.5)]"
>
  <div class="relative overflow-hidden">
    <img
      src={course.image}
      alt={course.imageAlt}
      class="w-full aspect-[4/3] object-cover"
      style={course.imageFocus ? `object-position: ${course.imageFocus}` : undefined}
      loading={eager ? "eager" : "lazy"}
      width="800"
      height="600"
    />
    <span class="absolute top-4 left-4 rounded-full bg-wine-deep/85 backdrop-blur text-white text-[0.7rem] tracking-[0.18em] uppercase px-3 py-1.5">
      {course.discipline}
    </span>
  </div>
  <div class="@container p-6 md:p-7">
    <div class="flex flex-col gap-x-4 @min-[25rem]:flex-row @min-[25rem]:items-baseline @min-[25rem]:justify-between">
      {/* Stacked cards sit in a grid row, so the title reserves two lines:
          without it a one-word wrap pushes that card's price out of line with its neighbours. */}
      <h3 class="font-display text-2xl leading-[1.35] min-h-[2lh] @min-[25rem]:min-h-0 group-hover:text-wine-soft transition-colors">
        {course.shortName}
      </h3>
      <p class="font-display text-xl text-gold-ink whitespace-nowrap mt-1 @min-[25rem]:mt-0">{formatTuition(course.tuition)}</p>
    </div>
    <p class="mt-3 text-sm text-muted leading-relaxed line-clamp-3">{course.intro}</p>
    <div class="mt-5 pt-4 border-t border-line flex items-center justify-between text-xs text-muted">
      <span>{course.level}</span>
      <span class="font-medium text-wine">
        {course.days} {course.days === 1 ? "day" : "days"}
        <span class="text-gold-ink ml-1 group-hover:translate-x-1 inline-block transition-transform" aria-hidden="true">→</span>
      </span>
    </div>
  </div>
</a>
