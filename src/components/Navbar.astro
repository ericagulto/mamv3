---
import { site, navLinks } from "../data/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header id="site-nav" class="nav fixed inset-x-0 top-0 z-50">
  <div class="nav-scrim absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="wrap relative flex items-center justify-end gap-6 py-4 lg:justify-between">
    <!-- Centered on the viewport below the desktop breakpoint, where it is the
         first flex item again. Absolute so the hamburger never shifts it off axis. -->
    <a
      href="/"
      class="absolute inset-y-0 left-1/2 flex -translate-x-1/2 items-center text-white lg:static lg:translate-x-0"
      aria-label={`${site.name} — home`}>
      <img
        src="/images/logo.png"
        alt=""
        width="366"
        height="89"
        class="h-14 md:h-16 w-auto"
      />
    </a>

    <nav class="hidden lg:flex flex-1 items-center justify-center gap-x-6 xl:gap-x-10" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "text-[0.78rem] font-medium uppercase tracking-[0.16em] whitespace-nowrap transition-colors",
              isActive(link.href) ? "text-gold" : "text-white/85 hover:text-white",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <!-- The hide lives on a wrapper, not the button: `.btn` sets `display:
           inline-flex` outside any layer, so it outranks Tailwind's `hidden`. -->
      <div class="hidden lg:block">
        <a href="/contact" class="btn btn-gold !py-2.5 !px-6 text-[0.95rem]">Inquire now</a>
      </div>

      <button
        id="menu-toggle"
        class="lg:hidden text-white p-2 -mr-2"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path class="icon-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          <path class="icon-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden bg-wine-deep/98 backdrop-blur border-t border-white/10">
    <nav class="wrap py-6 flex flex-col gap-1" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "py-3 text-lg font-medium border-b border-white/8",
              isActive(link.href) ? "text-gold" : "text-white",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/contact" class="btn btn-gold mt-5">Inquire now</a>
    </nav>
  </div>
</header>

<style>
  /* Solid by default: the bar carries white type over whatever the page scrolls
     beneath it, so an unreadable nav is the failure mode if no script runs. The
     transparent-over-hero state is opt-in, applied synchronously below. */
  .nav {
    background: rgb(37 0 16 / 0.92);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
  /* Subtle scrim so nav text stays readable over bright hero imagery — only
     while the bar itself is transparent. */
  .nav-scrim {
    background: linear-gradient(to bottom, rgb(37 0 16 / 0.55), rgb(37 0 16 / 0));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .nav.nav-js {
    background: transparent;
  }
  .nav.nav-js:not(.nav-scrolled) .nav-scrim {
    opacity: 1;
  }
  .nav.nav-js.nav-scrolled {
    background: rgb(37 0 16 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2px 16px rgb(0 0 0 / 0.25);
  }
</style>

<!-- Runs during parse, before first paint: no flash of the wrong state, and it
     cannot be taken down by a failure in the animation bundle. -->
<script is:inline>
  const nav = document.getElementById("site-nav");
  if (nav) {
    nav.classList.add("nav-js");
    const setScrolled = () => nav.classList.toggle("nav-scrolled", window.scrollY > 40);
    window.addEventListener("scroll", setScrolled, { passive: true });
    setScrolled();
  }
</script>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = toggle?.querySelector(".icon-open");
  const iconClose = toggle?.querySelector(".icon-close");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  });
</script>
